# ============================================================
# ApexTech Headless E-Commerce Storefront — Environment Variables
# Copy this file to .env and fill in your real values.
# ============================================================

# --- Database ---
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/apextech_db?schema=public"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe ---
# Secret key (server-side only — never expose to the client)
STRIPE_SECRET_KEY="your-stripe-secret-key-here"

# Publishable key (safe to expose to the client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key-here"

# Webhook signing secret (from Stripe dashboard -> Webhooks)
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret-here"
